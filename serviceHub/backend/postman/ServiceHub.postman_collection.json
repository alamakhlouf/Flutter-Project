{
  "info": {
    "_postman_id": "894af623-2b64-4c8c-a126-5d8415a00144",
    "name": "ServiceHub API",
    "description": "Complete ServiceHub REST API collection. Set baseUrl if needed. Register or log in to save the JWT into the collection token variable. Change the active account/role by running the matching login request. ADMIN routes are reserved for the future web backoffice.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "providerId", "value": "22222222-2222-4222-8222-222222222222" },
    { "key": "supplierId", "value": "33333333-3333-4333-8333-333333333333" },
    { "key": "serviceId", "value": "44444444-4444-4444-8444-444444444444" },
    { "key": "inventoryId", "value": "55555555-5555-4555-8555-555555555555" },
    { "key": "bookingId", "value": "66666666-6666-4666-8666-666666666666" },
    { "key": "productId", "value": "77777777-7777-4777-8777-777777777777" },
    { "key": "orderId", "value": "88888888-8888-4888-8888-888888888888" },
    { "key": "workshopId", "value": "99999999-9999-4999-8999-999999999999" },
    { "key": "reportId", "value": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa" },
    { "key": "notificationId", "value": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) { const data = pm.response.json(); if (data.token) pm.collectionVariables.set('token', data.token); if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Postman Customer\",\n  \"email\": \"postman-customer@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"CUSTOMER\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) { const data = pm.response.json(); if (data.token) pm.collectionVariables.set('token', data.token); if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@servicehub.local\",\n  \"password\": \"ServiceHub123!\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login as Provider (local seed)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) { const data = pm.response.json(); if (data.token) pm.collectionVariables.set('token', data.token); if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"provider@servicehub.local\",\n  \"password\": \"ServiceHub123!\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login as Supplier (local seed)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) { const data = pm.response.json(); if (data.token) pm.collectionVariables.set('token', data.token); if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"supplier@servicehub.local\",\n  \"password\": \"ServiceHub123!\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login as Admin (local seed; backoffice only)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) { const data = pm.response.json(); if (data.token) pm.collectionVariables.set('token', data.token); if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@servicehub.local\",\n  \"password\": \"ServiceHub123!\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get authenticated user",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        { "name": "Get my profile", "request": { "method": "GET", "url": "{{baseUrl}}/api/users/me" } },
        {
          "name": "Update my profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Updated Name\",\n  \"phone\": \"+15551234567\",\n  \"profileImageUrl\": \"https://example.com/profile.jpg\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/users/me"
          }
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        { "name": "List/search services", "request": { "method": "GET", "url": "{{baseUrl}}/api/services?search=&category=&page=0&size=20" } },
        { "name": "Get service", "request": { "method": "GET", "url": "{{baseUrl}}/api/services/{{serviceId}}" } },
        {
          "name": "Create service (PROVIDER)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('serviceId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Home cleaning\",\n  \"description\": \"Standard home cleaning service\",\n  \"category\": \"Home\",\n  \"price\": 45.00,\n  \"imageUrl\": \"https://example.com/service.jpg\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/services"
          }
        },
        {
          "name": "Update service (owner PROVIDER)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated service\",\n  \"description\": \"Updated description\",\n  \"category\": \"Home\",\n  \"price\": 50.00,\n  \"imageUrl\": \"https://example.com/service.jpg\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/services/{{serviceId}}"
          }
        },
        {
          "name": "Set service active (owner PROVIDER)",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"active\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/services/{{serviceId}}/active" }
        },
        { "name": "Delete/deactivate service (owner PROVIDER)", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/services/{{serviceId}}" } },
        { "name": "List provider services", "request": { "method": "GET", "url": "{{baseUrl}}/api/providers/{{providerId}}/services?page=0&size=20" } }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        { "name": "List my inventory (PROVIDER)", "request": { "method": "GET", "url": "{{baseUrl}}/api/inventory" } },
        { "name": "Get inventory item (owner PROVIDER)", "request": { "method": "GET", "url": "{{baseUrl}}/api/inventory/{{inventoryId}}" } },
        {
          "name": "Create inventory item (PROVIDER)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('inventoryId', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cleaning solution\",\n  \"description\": \"Multipurpose cleaner\",\n  \"quantity\": 12,\n  \"unit\": \"bottles\",\n  \"lowStockThreshold\": 3\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/inventory" }
        },
        {
          "name": "Update inventory item (owner PROVIDER)",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cleaning solution\",\n  \"description\": \"Updated inventory item\",\n  \"quantity\": 10,\n  \"unit\": \"bottles\",\n  \"lowStockThreshold\": 3\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/inventory/{{inventoryId}}" }
        },
        {
          "name": "Update quantity (owner PROVIDER)",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"quantity\": 8\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/inventory/{{inventoryId}}/quantity" }
        },
        { "name": "Delete inventory item (owner PROVIDER)", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/inventory/{{inventoryId}}" } }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create booking (CUSTOMER)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('bookingId', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"preferredDateTime\": \"2030-01-15T10:00:00Z\",\n  \"description\": \"Please call before arrival\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/bookings" }
        },
        { "name": "List my bookings (CUSTOMER/PROVIDER)", "request": { "method": "GET", "url": "{{baseUrl}}/api/bookings/my" } },
        { "name": "Get booking (participant)", "request": { "method": "GET", "url": "{{baseUrl}}/api/bookings/{{bookingId}}" } },
        {
          "name": "Update booking status (service PROVIDER)",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACCEPTED\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/bookings/{{bookingId}}/status" }
        },
        { "name": "Cancel booking (CUSTOMER)", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel" } }
      ]
    },
    {
      "name": "Suppliers and Products",
      "item": [
        { "name": "List suppliers", "request": { "method": "GET", "url": "{{baseUrl}}/api/suppliers" } },
        { "name": "Get supplier", "request": { "method": "GET", "url": "{{baseUrl}}/api/suppliers/{{supplierId}}" } },
        { "name": "List/search products", "request": { "method": "GET", "url": "{{baseUrl}}/api/products?search=&category=&page=0&size=20" } },
        { "name": "Get product", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" } },
        {
          "name": "Create product (SUPPLIER)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('productId', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Microfiber cloth set\",\n  \"description\": \"Reusable cleaning cloths\",\n  \"category\": \"Cleaning\",\n  \"price\": 9.50,\n  \"imageUrl\": \"https://example.com/product.jpg\",\n  \"quantityAvailable\": 40,\n  \"available\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/products" }
        },
        {
          "name": "Update product (owner SUPPLIER)",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Microfiber cloth set\",\n  \"description\": \"Updated reusable cleaning cloths\",\n  \"category\": \"Cleaning\",\n  \"price\": 10.00,\n  \"quantityAvailable\": 35,\n  \"available\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/products/{{productId}}" }
        },
        {
          "name": "Set product availability (owner SUPPLIER)",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"available\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/products/{{productId}}/availability" }
        },
        { "name": "Delete/deactivate product (owner SUPPLIER)", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/products/{{productId}}" } }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order (CUSTOMER)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('orderId', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 2 }\n  ]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/orders" }
        },
        { "name": "List my orders (CUSTOMER/SUPPLIER)", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/my" } },
        { "name": "Get order (participant)", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/{{orderId}}" } },
        {
          "name": "Update order status (SUPPLIER)",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACCEPTED\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/orders/{{orderId}}/status" }
        },
        { "name": "Cancel order (CUSTOMER)", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/orders/{{orderId}}/cancel" } }
      ]
    },
    {
      "name": "Workshops",
      "item": [
        { "name": "List/search workshops", "request": { "method": "GET", "url": "{{baseUrl}}/api/workshops?search=&category=&date=&availability=&page=0&size=20" } },
        { "name": "Get workshop", "request": { "method": "GET", "url": "{{baseUrl}}/api/workshops/{{workshopId}}" } },
        {
          "name": "Create workshop (PROVIDER)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('workshopId', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"DIY home care\",\n  \"description\": \"Learn basic home maintenance\",\n  \"category\": \"Home\",\n  \"coverImageUrl\": \"https://example.com/workshop.jpg\",\n  \"startDateTime\": \"2030-02-01T10:00:00Z\",\n  \"endDateTime\": \"2030-02-01T12:00:00Z\",\n  \"location\": \"ServiceHub studio\",\n  \"capacity\": 12,\n  \"registrationDeadline\": \"2030-01-31T10:00:00Z\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/workshops" }
        },
        {
          "name": "Update workshop (organizer PROVIDER)",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated workshop\",\n  \"description\": \"Updated details\",\n  \"category\": \"Home\",\n  \"startDateTime\": \"2030-02-01T10:00:00Z\",\n  \"endDateTime\": \"2030-02-01T12:00:00Z\",\n  \"location\": \"ServiceHub studio\",\n  \"capacity\": 12,\n  \"registrationDeadline\": \"2030-01-31T10:00:00Z\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/workshops/{{workshopId}}" }
        },
        { "name": "Publish workshop (organizer PROVIDER)", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/workshops/{{workshopId}}/publish" } },
        { "name": "Cancel workshop (organizer PROVIDER)", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/workshops/{{workshopId}}/cancel" } },
        { "name": "List my organized workshops (PROVIDER)", "request": { "method": "GET", "url": "{{baseUrl}}/api/workshops/my/organized" } },
        { "name": "List my registrations (CUSTOMER/PROVIDER)", "request": { "method": "GET", "url": "{{baseUrl}}/api/workshops/my/registrations" } },
        { "name": "List workshop participants (organizer PROVIDER)", "request": { "method": "GET", "url": "{{baseUrl}}/api/workshops/{{workshopId}}/participants" } },
        { "name": "Register for workshop (CUSTOMER/PROVIDER)", "request": { "method": "POST", "url": "{{baseUrl}}/api/workshops/{{workshopId}}/registrations" } },
        { "name": "Cancel my workshop registration (CUSTOMER/PROVIDER)", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/workshops/{{workshopId}}/registrations/me" } }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create review (CUSTOMER with completed booking)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"rating\": 5,\n  \"comment\": \"Excellent service\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/reviews"
          }
        },
        { "name": "List service reviews", "request": { "method": "GET", "url": "{{baseUrl}}/api/services/{{serviceId}}/reviews" } },
        { "name": "List provider reviews", "request": { "method": "GET", "url": "{{baseUrl}}/api/providers/{{providerId}}/reviews" } }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Submit report",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('reportId', pm.response.json().id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"targetType\": \"SERVICE\",\n  \"targetId\": \"{{serviceId}}\",\n  \"reason\": \"Inaccurate listing\",\n  \"description\": \"The listing details appear incorrect.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/reports" }
        },
        { "name": "List my reports", "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/my" } }
      ]
    },
    {
      "name": "Admin Reports (future web backoffice only)",
      "item": [
        { "name": "List all reports (ADMIN)", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/reports" } },
        { "name": "Get report (ADMIN)", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/reports/{{reportId}}" } },
        {
          "name": "Update report status (ADMIN)",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"UNDER_REVIEW\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/admin/reports/{{reportId}}/status" }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        { "name": "List my notifications", "request": { "method": "GET", "url": "{{baseUrl}}/api/notifications" } },
        {
          "name": "Mark notification read",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read" }
        },
        { "name": "Mark all notifications read", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/notifications/read-all" } }
      ]
    }
  ]
}
